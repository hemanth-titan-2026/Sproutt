# ---------------------------------------------------------------------------
# Sproutt — environment
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored; never commit real keys.
#
# Where to find these: Supabase Dashboard -> your project -> Project Settings
# -> API Keys.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public key — safe to expose to the browser. Row Level Security is what keeps
# your data private. Newer projects call this the "publishable" key
# (sb_publishable_...); older ones call it "anon". Either variable works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET key — bypasses Row Level Security. Server-side only, never NEXT_PUBLIC_.
# Needed for the payment webhook that marks orders paid (and mints trees).
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build email confirmation / password reset links.
# Local: http://localhost:3000 — production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Checkout without a payment provider.
#
# Sproutt has no payment gateway yet, by choice. With this set to "true", the
# Buy button creates the order and marks it paid immediately, which credits the
# trees. Without it, orders are created but stay unpaid and contribute nothing.
#
# So: you need this set for purchases to work at all right now — including in
# production. Know what that means before you deploy: orders complete for free,
# so anyone can award themselves trees and inflate the public counter. Fine for
# a demo, not for a real shop.
#
# Remove it once a payment provider and a signature-verified webhook are wired up.
SPROUTT_ALLOW_TEST_CHECKOUT=true
